.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
results/logs/
results/smoke/

# Generated multi-task corpora are too large for Git; the npz shards stay
# local, but their manifests (SHA256 provenance) are versioned so that anyone
# who regenerates or receives the data can verify integrity.
datasets/mt10/**/*.npz
datasets/mt50/**/*.npz
datasets/smoke/

# Local editor and operating-system files
.DS_Store
.idea/
.vscode/

# Runtime and experiment scratch files
*.tmp
*.bak
*.swp
wandb/
runs/

# LaTeX build intermediates (the source and compiled PDF are versioned)
paper_assets/*.aux
paper_assets/*.bbl
paper_assets/*.bcf
paper_assets/*.blg
paper_assets/*.fdb_latexmk
paper_assets/*.fls
paper_assets/*.log
paper_assets/*.out
paper_assets/*.run.xml
paper_assets/*.synctex.gz
paper_assets/_minted-*/

# Local manuscript notes and explanatory copies (not submission artifacts)
manuscript/annotated_copy_zh.tex
manuscript/annotated_copy_zh.pdf
manuscript/annotated_copy_zh.log
manuscript/meeting_brief_zh.md
output/pdf/REIM_annotated_explained_zh.pdf
manuscript/main.pdf
manuscript/unresolved_items.md

# Local manuscript build logs and review previews
manuscript/*.aux
manuscript/*.blg
manuscript/*.log
_preview_f1_final.png
tmp/

# Local reading copies and regenerable experiment diagnostics
_refs/
results/figures/_frames_backup_az150/
results/figures/mt50_seed*_detector_confusion.png
results/figures/mt50_seed*_detector_training.png
results/figures/mt50_seed*_recovery_training.png

# Per-shard evaluation outputs duplicate the merged local episode banks.
results/tables/mt50_seed*shard*

# Full per-episode MT50 seed banks and run sidecars stay local. The repository
# publishes condition summaries, training summaries, and the four-seed table.
results/tables/mt50_seed*_episodes.csv
results/tables/mt50_seed*_episodes.csv.run.json
results/tables/mt50_seed*confirm*_summary.json

# Publish only the frozen models used by the paper. Epoch-by-epoch ACT
# checkpoints and legacy PPO controls are reproducible but not repository assets.
checkpoints/*
!checkpoints/bc_policy.pt
!checkpoints/failure_detector.pt
!checkpoints/imitation_recovery.pt
!checkpoints/imitation_recovery.audit.json
